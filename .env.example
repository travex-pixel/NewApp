# Product analytics (PostHog). Leave unset to send nothing.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Absolute site URL for social previews. On Vercel this can stay unset.
NEXT_PUBLIC_SITE_URL=

# "What everyone picked" counts. Set automatically when Upstash Redis is connected in Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Local testing only: keep vote counts in memory. Never set on Vercel.
# CROWD_MEMORY=1
